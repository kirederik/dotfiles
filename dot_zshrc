# ─── Homebrew (Apple Silicon) ─────────────────────────────────────────────────
if [[ -f /opt/homebrew/bin/brew ]]; then
  eval "$(/opt/homebrew/bin/brew shellenv)"
fi

# ─── Completions (must run before antidote so plugins can call compdef) ───────
autoload -Uz compinit && compinit

# Complete bookmark names for all jj subcommands that accept them.
# The generated script uses _default everywhere; we patch three patterns:
#   ::names -- ...:_default'  → positional bookmark args (advance/create/delete/etc.)
#   ]:BOOKMARK:_default'      → jj git push --bookmark/-b
#   :old -- ...:_default'     → jj bookmark rename (first arg)
function _jj_bookmark_names() {
  local -a bookmarks
  bookmarks=(${(f)"$(jj bookmark list --template 'name ++ "\n"' --no-pager 2>/dev/null)"})
  compadd -a bookmarks
}
source <(
  jj util completion zsh | sed \
    -e "s/::names -- [^:]*:_default'/:names:_jj_bookmark_names'/g" \
    -e "s/]:BOOKMARK:_default'/]:BOOKMARK:_jj_bookmark_names'/g" \
    -e "s/:old -- The old name of the bookmark:_default'/:old:_jj_bookmark_names'/g"
)

# ─── Antidote plugin manager ──────────────────────────────────────────────────
source "$(brew --prefix)/opt/antidote/share/antidote/antidote.zsh"
antidote load

# ─── Mise runtime manager ─────────────────────────────────────────────────────
eval "$(mise activate zsh)"

# ─── Prompt ───────────────────────────────────────────────────────────────────
# Only init starship if not already loaded in this shell process.
# Uses a non-exported variable so the guard is local to this shell —
# child shells (e.g. new zellij panes) start fresh and init correctly,
# while re-sourcing .zshrc in the same session skips the re-init
# that causes ZLE widget re-wrapping (starship/issues/3418).
[[ -z $_starship_initialized ]] && {
  eval "$(starship init zsh)"
  _starship_initialized=1
}

# ─── Smart cd ─────────────────────────────────────────────────────────────────
eval "$(zoxide init zsh)"

# ─── direnv ───────────────────────────────────────────────────────────────────
eval "$(direnv hook zsh)"


# ─── zsh options ──────────────────────────────────────────────────────────────
# Characters listed here count as part of a word, so ctrl+w chews through them.
# Removed from zsh's default: "/" so ctrl+w stops at path separators (deletes
# only "d" from "a/b/c/d"), and "-" so it stops at hyphens (deletes only "name"
# from "feat/some-branch-name", and only "flag" from "--some-flag").
# This matters more since bindkey -e: emacs backward-kill-word honours
# WORDCHARS, whereas vi-backward-kill-word ignored it and broke on any
# punctuation. Drop "." here too if foo.bar.baz should delete piecewise.
WORDCHARS='*?_.[]~=&;!#$%^(){}<>'
setopt AUTO_CD          # type a dir name to cd into it
setopt CORRECT          # suggest correction for mistyped commands
setopt NO_BEEP          # silence all bells
setopt GLOB_DOTS        # include dotfiles in glob matches

# ─── Pager ────────────────────────────────────────────────────────────────────
export LESS='-R --use-color'
export MANPAGER='less -R --use-color -Dd+r -Du+b'

# ─── Editor ───────────────────────────────────────────────────────────────────
export EDITOR='nvim'
export VISUAL='nvim'

# Force emacs line editing at the prompt. zsh auto-selects the *vi* keymap when
# $EDITOR/$VISUAL matches *vi* — and "nvim" matches — which silently turns ^A,
# ^E, ^K and ^Y into self-insert. Must run after the plugin manager but before
# any bindkey below, since -e re-points `main` at the emacs keymap and would
# discard bindings made into viins.
bindkey -e

