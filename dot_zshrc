# Homebrew — sync installed packages to Brewfile (install missing + remove unlisted)
alias brewup='brew bundle install --file=~/.dotfiles/Brewfile && brew bundle cleanup --force --file=~/.dotfiles/Brewfile'

# Add a formula/cask to the Brewfile (auto-detecting which) and install it.
# Usage: brewadd <name> [more names...]
function brewadd() {
  local file="$HOME/.dotfiles/Brewfile"
  [[ -z "$1" ]] && { echo "usage: brewadd <name> [more...]"; return 1; }
  local name keyword flag line
  for name in "$@"; do
    if brew info --formula "$name" &>/dev/null; then
      keyword='brew'; flag='--formula'
    elif brew info --cask "$name" &>/dev/null; then
      keyword='cask'; flag='--cask'
    else
      echo "✗ '$name' is not a known formula or cask — skipping"
      continue
    fi
    line="$keyword '$name'"
    if grep -qF "$line" "$file"; then
      echo "• already in Brewfile: $line"
    else
      printf '%s\n' "$line" >> "$file"
      echo "✓ added to Brewfile: $line"
    fi
    brew install "$flag" "$name"
  done
}

# Update all non-Homebrew tools: mise runtimes, pipx packages, krew plugins.
function toolsup() {
  local _section() { print -P "\n%B%F{cyan}── $1 ──%f%b" }

  _section "mise runtimes (go · node · ruby · bun)"
  mise upgrade

  _section "pipx packages"
  pipx upgrade-all

  _section "krew plugins"
  kubectl krew upgrade
}

# Mob programming — keeps git mob and jj in sync
function mob() {
  if [[ $# -eq 0 ]]; then
    git mob --clear 2>/dev/null || true
    mob-jj
    echo "Mob session ended"
  else
    git mob "$@" && mob-jj "$@"
  fi
}

# ─── Zellij ───────────────────────────────────────────────────────────────────
# Strip ANSI color codes from zellij list-sessions output so fzf renders cleanly
_zj_sessions() { zellij list-sessions 2>/dev/null | sed 's/\x1b\[[0-9;]*m//g' | awk '{print $1}'; }

# Smart attach: fzf if multiple sessions, direct if one, new if none
function zj() {
  # check if there's an argument; if so, start a named session
  if [[ $# -gt 0 ]]; then
    zellij --session "$1"
    return
  fi
  local sessions session
  sessions=$(_zj_sessions)
  if [[ -z "$sessions" ]]; then
    zellij
  elif [[ $(echo "$sessions" | wc -l) -eq 1 ]]; then
    zellij attach "$sessions"
  else
    session=$(echo "$sessions" | fzf --prompt='attach> ') \
      && zellij attach "$session"
  fi
}

# Kill session via fzf
function zjk() {
  local session
  session=$(_zj_sessions | fzf --prompt='kill> ') \
    && zellij kill-session "$session"
}

# Delete a single session via fzf
function zjd() {
  local session
  session=$(_zj_sessions | fzf --prompt='delete> ') \
    && zellij delete-session "$session"
}

alias zjl='zellij list-sessions'

# ─── Zellij: lock/unlock helpers ─────────────────────────────────────────────
# zlock — lock from the terminal prompt or a shell command in any context.
# Mirrors the Ctrl+Space,l keybind but usable without the prefix.
alias zlock='zellij action switch-mode locked'

# ─── Zellij: auto-lock for TUI apps ──────────────────────────────────────────
# Locks Zellij when a TUI app launches, unlocks when it exits.
# Manual Ctrl+G to unlock mid-session; zlock or Ctrl+Space,l to re-lock.
_zellij_wrap() {
  local cmd="$1"
  eval "function $cmd() {
    if [[ -n \$ZELLIJ ]]; then
      zellij action switch-mode locked
      command $cmd \"\$@\"
      local ret=\$?
      zellij action switch-mode normal
      return \$ret
    else
      command $cmd \"\$@\"
    fi
  }"
}

for cmd in nvim vim lazygit k9s btop fzf-make; do
  _zellij_wrap "$cmd"
done
unset -f _zellij_wrap

# ─── Herdr: refresh the jj sidebar row after every command ────────────────────
# The mroth.jj-status plugin only refreshes on `workspace.focused` (plus one-shot
# lifecycle events), so a `jj commit`/`jj bookmark set` leaves the sidebar stale
# until you leave and re-enter the space. Nudging it from precmd makes it live.
#
# `plugin action invoke` is fire-and-forget: it queues the sweep server-side and
# returns in ~12ms, so this adds no perceptible prompt latency. Redirected and
# `|| true` so a stopped Herdr server can never break the prompt.
if [[ -n $HERDR_ENV ]] && command -v herdr &>/dev/null; then
  autoload -Uz add-zsh-hook
  _herdr_jj_refresh() {
    herdr plugin action invoke refresh --plugin mroth.jj-status &>/dev/null || true
  }
  add-zsh-hook precmd _herdr_jj_refresh
fi

