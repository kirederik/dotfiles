// Zellij config
// Uses Zellij's built-in Tmux mode as a prefix layer.
// Workflow: Ctrl+Space arms the leader, next key acts and drops back to Normal —
// identical to how C-space works as a tmux prefix.
// Docs: https://zellij.dev/documentation/

theme "catppuccin-mocha"
simplified_ui false
default_layout "default"
copy_on_select true
scroll_buffer_size 10000
pane_frames true
show_startup_tips false

on_force_close "detach"

keybinds clear-defaults=false {

    // ── Remove noisy default Alt bindings from status bar ─────────────────────
    shared_except "locked" {
        unbind "Alt +" "Alt ="
        unbind "Alt -"
        // Free Ctrl+G so it passes through to zsh (ghq repo jumper).
        unbind "Ctrl g"
    }

    // ── Normal mode ────────────────────────────────────────────────────────
    normal {
        // Ctrl+Space arms the leader — mirrors tmux prefix
        bind "Ctrl space" { SwitchToMode "tmux"; }

        // Zellij's own mode UI (keep accessible)
        bind "Ctrl p" { SwitchToMode "pane"; }
        bind "Ctrl t" { SwitchToMode "tab"; }
        bind "Ctrl n" { SwitchToMode "resize"; }
        bind "Ctrl o" { SwitchToMode "session"; }
        bind "Ctrl q" { Quit; }

        // Pass through emacs line-nav and ESC+. to the shell.
        bind "Ctrl a" { Write 1; }
        bind "Ctrl e" { Write 5; }
        bind "Ctrl k" { Write 11; }
        bind "Alt ." { WriteChars "\u{1b}."; }
    }

    // ── Locked mode ────────────────────────────────────────────────────────
    locked {
        bind "Ctrl g" { SwitchToMode "normal"; }
    }

    // ── Tmux (leader) mode ─────────────────────────────────────────────────
    tmux {
        bind "Esc" { SwitchToMode "normal"; }
        bind "Ctrl space" { ToggleTab; SwitchToMode "normal"; }

        // Pane navigation
        bind "h" { MoveFocus "left";  SwitchToMode "normal"; }
        bind "j" { MoveFocus "down";  SwitchToMode "normal"; }
        bind "k" { MoveFocus "up";    SwitchToMode "normal"; }
        bind "l" { MoveFocus "right"; SwitchToMode "normal"; }
        bind "o" { FocusNextPane;     SwitchToMode "normal"; }

        // Pane management
        bind "x" { CloseFocus;              SwitchToMode "normal"; }
        bind "z" { ToggleFocusFullscreen;   SwitchToMode "normal"; }
        bind "v" { NewPane "right";         SwitchToMode "normal"; }
        bind "-" { NewPane "down";          SwitchToMode "normal"; }
        bind "f" { ToggleFloatingPanes;     SwitchToMode "normal"; }

        // Tab navigation
        bind "n"   { GoToNextTab;       SwitchToMode "normal"; }
        bind "p"   { GoToPreviousTab;   SwitchToMode "normal"; }
        bind "tab" { GoToPreviousTab;   SwitchToMode "normal"; }
        bind "c"   { NewTab;            SwitchToMode "normal"; }

        // Tab reordering
        bind "<" { MoveTab "left";  SwitchToMode "normal"; }
        bind ">" { MoveTab "right"; SwitchToMode "normal"; }

        // Scroll / copy mode
        bind "[" { SwitchToMode "scroll"; }

        // Jump to tab by number
        bind "1" { GoToTab 1; SwitchToMode "normal"; }
        bind "2" { GoToTab 2; SwitchToMode "normal"; }
        bind "3" { GoToTab 3; SwitchToMode "normal"; }
        bind "4" { GoToTab 4; SwitchToMode "normal"; }
        bind "5" { GoToTab 5; SwitchToMode "normal"; }
        bind "6" { GoToTab 6; SwitchToMode "normal"; }
        bind "7" { GoToTab 7; SwitchToMode "normal"; }
        bind "8" { GoToTab 8; SwitchToMode "normal"; }
        bind "9" { GoToTab 9; SwitchToMode "normal"; }

        // Session manager
        bind "s" "g" { SwitchToMode "session"; }

        // Manual lock — pass all keys to the focused app (e.g. nvim)
        bind "l" { SwitchToMode "locked"; }
    }

    // ── Scroll mode ────────────────────────────────────────────────────────
    scroll {
        bind "Esc" "q"    { SwitchToMode "normal"; }
        bind "e"          { EditScrollback; }
        bind "j" "down"   { ScrollDown; }
        bind "k" "up"     { ScrollUp; }
        bind "Ctrl d"     { HalfPageScrollDown; }
        bind "Ctrl u"     { HalfPageScrollUp; }
        bind "Ctrl f"     { PageScrollDown; }
        bind "Ctrl b"     { PageScrollUp; }
        bind "G"          { ScrollToBottom; }
        bind "g"          { ScrollToTop; }
        bind "/"          { SwitchToMode "entersearch"; }
    }

    // ── Search mode ────────────────────────────────────────────────────────
    search {
        bind "Esc" "enter" { SwitchToMode "scroll"; }
        bind "n"           { Search "down"; }
        bind "N"           { Search "up"; }
    }

    // ── Pane mode ─────────────────────────────────────────────────────────
    pane {
        bind "Esc" "Ctrl p" { SwitchToMode "normal"; }
        bind "h" "left"  { MoveFocus "left"; }
        bind "j" "down"  { MoveFocus "down"; }
        bind "k" "up"    { MoveFocus "up"; }
        bind "l" "right" { MoveFocus "right"; }
        bind "v"         { NewPane "right"; SwitchToMode "normal"; }
        bind "-"         { NewPane "down";  SwitchToMode "normal"; }
        bind "x"         { CloseFocus;      SwitchToMode "normal"; }
        bind "z"         { ToggleFocusFullscreen; SwitchToMode "normal"; }
        bind "f"         { ToggleFloatingPanes;   SwitchToMode "normal"; }
        bind "r"         { SwitchToMode "renamepane"; }
    }

    // ── Tab mode ──────────────────────────────────────────────────────────
    tab {
        bind "Esc" "Ctrl t" { SwitchToMode "normal"; }
        bind "n"            { NewTab; SwitchToMode "normal"; }
        bind "x"            { CloseTab; SwitchToMode "normal"; }
        bind "h" "left"     { GoToPreviousTab; }
        bind "l" "right"    { GoToNextTab; }
        bind "<"            { MoveTab "left"; }
        bind ">"            { MoveTab "right"; }
        bind "r"            { SwitchToMode "renametab"; }
    }

    // ── Resize mode ───────────────────────────────────────────────────────
    resize {
        bind "Esc" "Ctrl n" { SwitchToMode "normal"; }
        bind "h" "left"  { Resize "Increase left"; }
        bind "j" "down"  { Resize "Increase down"; }
        bind "k" "up"    { Resize "Increase up"; }
        bind "l" "right" { Resize "Increase right"; }
        bind "H"         { Resize "Decrease left"; }
        bind "J"         { Resize "Decrease down"; }
        bind "K"         { Resize "Decrease up"; }
        bind "L"         { Resize "Decrease right"; }
    }
}
