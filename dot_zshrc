# ─── ghq + fzf: ctrl+g → fuzzy repo jumper ────────────────────────────────────
export GHQ_ROOT="$HOME/dev"

function _ghq_fzf() {
  local repo
  repo=$(ghq list | fzf --height 40% --reverse --query "$LBUFFER") || return
  BUFFER="cd $(ghq root)/$repo"
  zle accept-line
}
zle -N _ghq_fzf
bindkey '^g' _ghq_fzf

# ─── MinIO (mc) ───────────────────────────────────────────────────────────────
# Register local kind cluster's MinIO as "kind" alias only if the port is open.
if command -v mc &>/dev/null && nc -z localhost 31337 2>/dev/null; then
  mc alias set kind http://localhost:31337 minioadmin minioadmin >/dev/null 2>&1
fi

