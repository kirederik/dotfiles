# Added by OrbStack: 'orb' SSH host for Linux machines
# This only works if it's at the top of ssh_config (before any Host blocks).
# This won't be added again if you remove it.
Include ~/.orbstack/ssh/config

# ─── SSH agent ────────────────────────────────────────────────────────────────
# Use Bitwarden's SSH agent for all hosts.
# Bitwarden must be running with Settings → SSH Agent enabled.
Host github.com
    IdentityAgent "~/.bitwarden-ssh-agent.sock"
    IdentityFile ~/.ssh/github.pub
    IdentitiesOnly yes

Host *
    IdentityAgent "~/.bitwarden-ssh-agent.sock"

    # Reuse connections — drastically speeds up repeated git push/pull to same host
    ControlMaster auto
    ControlPath ~/.ssh/sockets/%r@%h:%p
    ControlPersist 10m

    # Keep connections alive through NAT/firewalls
    ServerAliveInterval 60
    ServerAliveCountMax 3
