font-family = Monaco Nerd Font
font-size = 13
theme = Catppuccin Mocha

cursor-style = block
cursor-style-blink = false

shell-integration = zsh

macos-option-as-alt = left

# UK keyboard: alt+shift+3 normally produces # via macOS composition, but
# macos-option-as-alt=left intercepts it as an escape sequence instead.
# This override sends the literal # character.
keybind = alt+3=text:#

# Window
window-padding-x = 8
window-padding-y = 8
window-decoration = true
macos-titlebar-style = tabs

# Scrollback
scrollback-limit = 10000

# Close confirmation only when processes are running
confirm-close-surface = true

# Copy on select
copy-on-select = true

# Open new splits in the same working directory
window-inherit-working-directory = true
